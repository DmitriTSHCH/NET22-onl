@model IEnumerable<MvcProject.Models.Product>

<h1>Продукты на складе</h1>

<div>
    <table class="table table-striped table-hover">
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Категория</th>
            <th>Описание</th>
            <th>Действие</th>
        </tr>
        @foreach (var product in Model)
        {
            <tr>
                <th>@product.Id .</th>
                <th>@product.Name</th>
                <th>@product.Category</th>
                <th>@product.Description</th>
                <th>
                    <form>
                        <input hidden type="text" name="action" value=delete />
                        <input hidden type="number" value=@product.Id name="productId" />
                        <input type="submit" value="Удалить" />
                    </form>
                </th>
            </tr>
        }
        <tr>
            <form>
            <th></th>
            <th>
                <input type="text" name="name" required />
            </th>
            <th>  
                <select type="text" name="category">
                    <option value="">*Выберите категорию*</option>
                    <option value="electronics">Электроника</option>
                    <option value="furniture">Мебель</option>
                    <option value="cloth">Одежда</option>
                    <option value="other">Другое</option>
                </select>
            </th>
            <th>
                <input type="text" name="Description" />
            </th>
            <th>
                <input hidden type="text" name="action" value=add />
                <input type="submit" value="Добавить" />
            </th>
            </form>
        </tr>
        <tr>
            <form>
            <th>                
                <input type="text" name="productId" required />
            </th>
            <th>
                <input type="text" name="name" />
            </th>
            <th>
                <select type="text" name="category">
                    <option value="">*Выберите категорию*</option>
                    <option value="electronics">Электроника</option>
                    <option value="furniture">Мебель</option>
                    <option value="cloth">Одежда</option>
                    <option value="other">Другое</option>
                </select>
            </th>
            <th>
                <input type="text" name="Description" />
            </th>
            <th>
                <input hidden type="text" name="action" value=add />
                <input type="submit" value="Изменить" />
            </th>
            </form>
        </tr>
    </table>
</div>
<div>

</div>

