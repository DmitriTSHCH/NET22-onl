@{
    ViewData["Title"] = "Home Page";
}
@model IEnumerable<Sparja.Models.SparjaEnjoyerForm>

<h1>Едят спаржу</h1>

<div>
    <table class="table table-striped table-hover">
        <tr>
            <th>ID</th>
            <th>Имя</th>
            <th>Email</th>
            <th>Сколько съел</th>
        </tr>
        @foreach (var enjoyer in Model)
        {
            <tr>
                <th>@enjoyer.Id .</th>
                <th>@enjoyer.Name</th>
                <th>@enjoyer.Email</th>
                <th>@enjoyer.MealSparjaCount</th>
            </tr>
        }
        <tr>
            <form>
            <th></th>
            <th>
                <input type="text" name="name" required />
            </th>
            <th>
                <input type="text" name="email" required />
            </th>
            <th>
                <input hidden type="text" name="action" value=add />
                <input type="submit" value="Отправить" />
            </th>
            </form>
        </tr>
    </table>
</div>